<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Blogs - My Blog</title>
</head>

<body>
    <header class="d-flex justify-content-center py-3">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a href="/" class="nav-link" aria-current="page">Home</a>
            </li>
            <li class="nav-item">
                <a href="/compose" class="nav-link">Compose</a>
            </li>
            <li class="nav-item">
                <a href="/blogs" class="nav-link active">Blogs</a>
            </li>
        </ul>
    </header>
    <div class="container">
        <h1>Blog Posts</h1>
        <% if (posts.length===0) { %>
            <div class="blog" style="text-align: center;">
                <p style="color: var(--text-secondary); font-size: 1.125rem;">
                    No blog posts yet.
                    <a href="/compose"
                        style="color: var(--primary-color); text-decoration: none; font-weight: 600;">Write your first
                        post!</a>
                </p>
            </div>
            <% } else { %>
                <ul>
                    <% posts.forEach(function(post) { %>
                        <li>
                            <h2>
                                <%= post.title %>
                            </h2>
                            <p>
                                <%= post.content %>
                            </p>
                            <div class="meta">
                                <span>📅 <%= post.date %></span>
                            </div>
                        </li>
                        <% }); %>
                </ul>
                <% } %>
    </div>
    <%- include("./partials/footer") %>
</body>

</html>